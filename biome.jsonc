{
	"$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		// Biome 2.5 lints SVG. These are traced source art for the models, not UI markup.
		"includes": ["**", "!**/*.svg"]
	},
	"formatter": {
		"lineWidth": 120
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		},
		"formatter": {
			"quoteStyle": "single"
		}
	},
	"javascript": {
		"formatter": {
			"semicolons": "asNeeded",
			"quoteStyle": "single",
			"jsxQuoteStyle": "single"
		}
	},
	"linter": {
		"rules": {
			"style": {
				// getElementById('root')! is standard React boilerplate — not a real bug risk
				"noNonNullAssertion": "off"
			}
		}
	}
}
